{
  "name": "scratchpad",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=src/server --watch-path=src/shared src/server/index.ts",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node src/server/index.ts",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "prepare": "husky",
    "test": "playwright test"
  },
  "dependencies": {
    "@automerge/automerge": "^3.5.0",
    "@automerge/automerge-codemirror": "^0.2.0",
    "@automerge/automerge-repo": "^2.5.6",
    "@automerge/automerge-repo-network-broadcastchannel": "^2.5.6",
    "@automerge/automerge-repo-network-websocket": "^2.5.6",
    "@automerge/automerge-repo-react-hooks": "^2.5.6",
    "@automerge/automerge-repo-storage-indexeddb": "^2.5.6",
    "@automerge/automerge-repo-storage-nodefs": "^2.5.6",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "codemirror": "^6.0.2",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-wasm": "^3.6.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,md,css,html,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=24"
  }
}
